<Window x:Class="ExampleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExampleCalculator"
        mc:Ignorable="d"
        Title="Сучасний калькулятор" Height="550" Width="400"
        MinHeight="400" MinWidth="300"
        Background="#FF1E1E1E">

    <Window.Resources>
        <!-- Стиль для звичайних кнопок (цифри) -->
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок операцій (+, -, =) -->
        <Style x:Key="OperatorButtonStyle" BasedOn="{StaticResource CalcButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#FFFF9500"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFAB33"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для додаткових кнопок (C, тощо) -->
        <Style x:Key="ActionButtonStyle" BasedOn="{StaticResource CalcButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#FF505050"/>
            <Setter Property="Foreground" Value="#FFF0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF606060"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Заголовок вікна -->
        <TextBlock DockPanel.Dock="Top"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Margin="0,0,0,10"
                   Foreground="#FFA0A0A0">
            Наш калькулятор
        </TextBlock>

        <!-- Головна панель калькулятора -->
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Дисплей -->
                <RowDefinition Height="*"/>
                <!-- Сітка кнопок -->
            </Grid.RowDefinitions>

            <!-- Екран (TextBox) -->
            <Border Grid.Row="0" 
                    Background="#FF2D2D2D" 
                    CornerRadius="12" 
                    Margin="0,0,0,12" 
                    Padding="10">
                <TextBox x:Name="DisplayTextBox"
                         FontSize="36" 
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         TextAlignment="Right"
                         IsReadOnly="True"
                         Text="0"/>
            </Border>

            <!-- Кнопки (сітка 4x4) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Рядок 0 -->
                <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource ActionButtonStyle}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="±" Style="{StaticResource ActionButtonStyle}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="%" Style="{StaticResource ActionButtonStyle}"/>
                <Button Grid.Row="0" Grid.Column="3" Content="÷" Style="{StaticResource OperatorButtonStyle}"/>

                <!-- Рядок 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource OperatorButtonStyle}"/>

                <!-- Рядок 2 -->
                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="2" Grid.Column="3" Content="-" Style="{StaticResource OperatorButtonStyle}"/>

                <!-- Рядок 3 -->
                <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcButtonStyle}"/>
                <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource OperatorButtonStyle}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>